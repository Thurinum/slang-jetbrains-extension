<idea-plugin>
    <id>io.github.thurinum.slang</id>

    <name>Slang [Unofficial] (Thurinum)</name>

    <vendor url="https://github.com/Thurinum">Thurinum</vendor>

    <description>
        <![CDATA[
        <p>Slang [Unofficial] is a plugin that provides Slang language support for Jetbrain's platforms. This plugin is not an official Slang plugin.</p>
        <p>This is the Thurinum fork of <a href="https://github.com/16-Bit-Dog/slang-jetbrains-extension">16-Bit-Dog's Slang [Unofficial]</a>, released under the Apache License 2.0. It fixes crashes caused by slangd returning empty objects for list-typed results.</p>
        <p>To use this plugin, please add `slangd` to the PATH. This can be done through adding `$VK_SDK_PATH/bin` to your `PATH` environment variable </p>
        ]]>
    </description>

    <change-notes><![CDATA[
        <h2>0.0.12</h2>
        <ul>
            <li>Fixed "Cannot start Slang language server" crashes caused by the plugin bundling its own copy of Gson.</li>
            <li>Fixed "Cannot start Slang language server" when slangd returns an empty JSON object for definition/document symbol requests.</li>
            <li>Go to definition and the rest of IntelliSense no longer stop working after such a request.</li>
            <li>Fixed crashes caused by ambiguous LSP4J Either responses (0.0.10).</li>
        </ul>
    ]]>
    </change-notes>
    <!-- Product and plugin compatibility requirements. -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Slang" implementationClass="slanglsp.SlangFileType" fieldName="INSTANCE" language="Slang" extensions="slang;slangh"/>
        
        <lang.parserDefinition language="Slang" implementationClass="slanglsp.SlangParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Slang" implementationClass="slanglsp.SlangSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="Slang" implementationClass="slanglsp.SlangBraceMatcher"/>
        <lang.quoteHandler language="Slang" implementationClass="slanglsp.SlangQuoteHandler"/>
        <lang.commenter language="Slang" implementationClass="slanglsp.SlangCommenter"/>
        <lang.foldingBuilder language="Slang"
                            implementationClass="com.redhat.devtools.lsp4ij.features.foldingRange.LSPFoldingRangeBuilder"
                            order="first"/>
        <codeBlockProvider language="Slang"
                           implementationClass="com.redhat.devtools.lsp4ij.features.codeBlockProvider.LSPCodeBlockProvider"
                           order="first"/>

        <gotoDeclarationHandler implementation="slanglsp.SlangGotoDeclarationHandler"
                                order="first, before LSPGotoDeclarationHandler"/>

        <renameHandler id="SlangRenameHandler"
                       implementation="slanglsp.SlangRenameHandler"
                       order="first, before LSPRenameHandler"/>

        <codeInsight.parameterInfo
                language="Slang"
                implementationClass="com.redhat.devtools.lsp4ij.features.signatureHelp.LSPParameterInfoHandler"/>

        <lang.psiStructureViewFactory language="Slang"
                                      implementationClass="com.redhat.devtools.lsp4ij.features.documentSymbol.LSPDocumentSymbolStructureViewFactory"/>

        <notificationGroup id="Slang LSP"
                           displayType="BALLOON"/>

        <projectConfigurable
                parentId="tools"
                instance="slanglsp.SlangConfigurable"
                id="slanglsp.SlangConfigurable"
                displayName="Slang"
                nonDefaultProject="true"/>

        <projectService 
                serviceImplementation="slanglsp.SlangPersistentStateConfig"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="slanglsp.SlangLanguageServer"
                name="Slang Language Server"
                factoryClass="slanglsp.SlangLanguageServerFactory">
            <description><![CDATA[
        Slang Language Server.
        ]]>
            </description>
        </server>

        <languageMapping language="Slang"
                         serverId="slanglsp.SlangLanguageServer"
                         languageId="slang"/>
    </extensions>

</idea-plugin>